<view class="container">
  <!-- 关于 -->
  <view class="section">
    <view class="section-title">关于</view>
    <view class="setting-item">
      <text class="setting-label">版本</text>
      <text class="setting-value">1.0.0</text>
    </view>
    <view class="setting-item">
      <text class="setting-label">开发者</text>
      <text class="setting-value">备忘录团队</text>
    </view>
  </view>

  <!-- 数据管理 -->
  <view class="section">
    <view class="section-title">数据管理</view>
    <view class="setting-item" bindtap="exportNotes">
      <text class="setting-label">导出笔记</text>
      <text class="setting-icon">›</text>
    </view>
    <view class="setting-item" bindtap="clearAllNotes">
      <text class="setting-label">清空所有笔记</text>
      <text class="setting-value" style="color: #E74C3C;">⚠️</text>
    </view>
  </view>

  <!-- 统计信息 -->
  <view class="section">
    <view class="section-title">统计</view>
    <view class="setting-item">
      <text class="setting-label">笔记总数</text>
      <text class="setting-value">{{noteCount}}</text>
    </view>
  </view>
</view>