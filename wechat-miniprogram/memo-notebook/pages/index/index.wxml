<view class="container">
  <!-- 搜索栏 -->
  <view class="search-box">
    <input class="search-input" placeholder="搜索笔记..." value="{{searchText}}" bindinput="onSearchInput" />
  </view>

  <!-- 笔记列表 -->
  <view class="notes-list">
    <block wx:if="{{filteredNotes.length > 0}}">
      <view class="note-item" wx:for="{{filteredNotes}}" wx:key="id" bindtap="openNote" data-id="{{item.id}}">
        <view class="note-header">
          <text class="note-title">{{item.title}}</text>
          <text class="note-time">{{item.updateTime}}</text>
        </view>
        <view class="note-content">{{item.content}}</view>
      </view>
    </block>
    
    <!-- 空状态 -->
    <view class="empty-state" wx:else>
      <image class="empty-icon" src="data:image/svg+xml;base64," mode="aspectFit"></image>
      <text class="empty-text">{{searchText ? '未找到相关笔记' : '还没有笔记，点击下方按钮添加'}}</text>
    </view>
  </view>

  <!-- 浮动添加按钮 -->
  <view class="add-btn" bindtap="addNote">
    <text class="add-icon">+</text>
  </view>
</view>