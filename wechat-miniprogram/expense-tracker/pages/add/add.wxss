/* 添加记录页面样式 */
.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 类型切换 */
.type-tabs {
  display: flex;
  background: #fff;
  padding: 20rpx 30rpx;
  margin-bottom: 30rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 32rpx;
  color: #999;
  position: relative;
  transition: color 0.3s;
}

.tab-item.active {
  color: #667eea;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 3rpx;
}

/* 金额输入 */
.amount-section {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 40rpx 30rpx;
  margin-bottom: 20rpx;
}

.currency {
  font-size: 56rpx;
  font-weight: 600;
  color: #333;
  margin-right: 20rpx;
}

.amount-input {
  flex: 1;
  font-size: 56rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.2;
}

.amount-input::placeholder {
  color: #ddd;
}

/* 日期选择 */
.date-section {
  background: #fff;
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  position: relative;
}

.date-label {
  font-size: 30rpx;
  color: #333;
}

.date-picker {
  display: flex;
  align-items: center;
}

.date-text {
  font-size: 30rpx;
  color: #666;
  margin-right: 10rpx;
}

.date-arrow {
  font-size: 40rpx;
  color: #ccc;
  line-height: 1;
}

.date-section picker {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  opacity: 0;
}

/* 分类选择 */
.category-section {
  background: #fff;
  padding: 30rpx;
  flex: 1;
}

.section-label {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 30rpx;
  display: block;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 30rpx 20rpx;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 10rpx;
  border-radius: 16rpx;
  transition: all 0.3s;
}

.category-item:active {
  opacity: 0.7;
}

.category-item.active {
  background: #f5f5f5;
}

.category-icon-wrapper {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.category-emoji {
  font-size: 50rpx;
}

.category-name {
  font-size: 24rpx;
  color: #666;
}

/* 备注输入 */
.remark-section {
  background: #fff;
  padding: 30rpx;
  margin-top: 20rpx;
  display: flex;
  align-items: center;
}

.remark-label {
  font-size: 30rpx;
  color: #333;
  margin-right: 30rpx;
  white-space: nowrap;
}

.remark-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.remark-input::placeholder {
  color: #ccc;
}

/* 保存按钮 */
.save-section {
  padding: 30rpx;
  background: #fff;
  margin-top: auto;
}

.save-btn {
  width: 100%;
  height: 90rpx;
  background: #ddd;
  color: #999;
  border: none;
  border-radius: 45rpx;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 90rpx;
  padding: 0;
  transition: all 0.3s;
}

.save-btn::after {
  border: none;
}

.save-btn.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.save-btn[disabled] {
  opacity: 1;
}
