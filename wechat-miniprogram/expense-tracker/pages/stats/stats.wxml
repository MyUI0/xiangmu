<!-- 统计页面 -->
<view class="container">
  <!-- 月份切换 -->
  <view class="month-selector">
    <view class="month-btn" bindtap="prevMonth">
      <text class="month-arrow">‹</text>
    </view>
    <view class="month-text">{{monthText}}</view>
    <view class="month-btn" bindtap="nextMonth">
      <text class="month-arrow">›</text>
    </view>
  </view>

  <!-- 收支概览 -->
  <view class="overview-card">
    <view class="overview-item">
      <text class="overview-label">总收入</text>
      <text class="overview-value income">¥{{totalIncome}}</text>
    </view>
    <view class="overview-divider"></view>
    <view class="overview-item">
      <text class="overview-label">总支出</text>
      <text class="overview-value expense">¥{{totalExpense}}</text>
    </view>
    <view class="overview-divider"></view>
    <view class="overview-item">
      <text class="overview-label">结余</text>
      <text class="overview-value {{balance >= 0 ? 'income' : 'expense'}}">¥{{balanceText}}</text>
    </view>
  </view>

  <!-- 类型切换 -->
  <view class="stats-tabs">
    <view class="stats-tab {{statsType === 'expense' ? 'active' : ''}}" bindtap="switchStatsType" data-type="expense">
      <text>支出统计</text>
    </view>
    <view class="stats-tab {{statsType === 'income' ? 'active' : ''}}" bindtap="switchStatsType" data-type="income">
      <text>收入统计</text>
    </view>
  </view>

  <!-- 分类统计 -->
  <view class="category-stats">
    <view wx:if="{{categoryStats.length === 0}}" class="empty-stats">
      <text class="empty-icon">📊</text>
      <text class="empty-text">本月暂无{{statsType === 'expense' ? '支出' : '收入'}}记录</text>
    </view>
    
    <view wx:else class="category-list">
      <view wx:for="{{categoryStats}}" wx:key="id" class="category-stat-item">
        <view class="category-left">
          <view class="category-icon" style="background-color: {{color}}20">
            <text class="category-emoji">{{icon}}</text>
          </view>
          <view class="category-info">
            <text class="category-name">{{name}}</text>
            <text class="category-percent">{{percent}}%</text>
          </view>
        </view>
        <view class="category-right">
          <text class="category-amount">¥{{amount}}</text>
        </view>
      </view>
      
      <!-- 进度条 -->
      <view class="progress-section">
        <view class="progress-bar">
          <view wx:for="{{categoryStats}}" 
                wx:key="id" 
                class="progress-segment" 
                style="width: {{percent}}%; background-color: {{color}};"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 每日趋势 -->
  <view class="trend-section" wx:if="{{dailyTrend.length > 0}}">
    <view class="section-header">
      <text class="section-title">每日趋势</text>
    </view>
    <view class="trend-chart">
      <view wx:for="{{dailyTrend}}" wx:key="date" class="trend-item">
        <view class="trend-bar-wrapper">
          <view class="trend-bar" style="height: {{height}}%; background-color: {{statsType === 'expense' ? '#ef4444' : '#10b981'}};"></view>
        </view>
        <text class="trend-day">{{day}}</text>
      </view>
    </view>
  </view>
</view>
